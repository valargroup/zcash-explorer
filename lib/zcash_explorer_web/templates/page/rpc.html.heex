<main class="py-4">
  <div class="mx-4 sm:mx-8">
    <div class="mb-6">
      <h3 class="text-lg leading-6 font-medium text-gray-500 py-2 dark:text-slate-300">
        Public JSON-RPC endpoints
      </h3>
      <p class="text-sm text-gray-500 dark:text-slate-400">
        Endpoints discovered from the Kresko network metadata installed with this explorer.
      </p>
    </div>

    <%= if Enum.empty?(@rpc_endpoints) do %>
      <div class="rounded-md border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-800 dark:border-yellow-700 dark:bg-yellow-900 dark:text-yellow-100">
        No public RPC endpoints were found for this explorer.
      </div>
    <% else %>
      <div class="overflow-x-auto border border-gray-200 shadow sm:rounded-md dark:border-slate-700">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
          <thead class="bg-gray-50 dark:bg-slate-800">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-300">Node</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-300">Region</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-300">Endpoint</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-300">Run</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-700 dark:bg-slate-900">
            <%= for endpoint <- @rpc_endpoints do %>
              <tr>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-gray-900 dark:text-slate-100">
                  <div class="font-medium"><%= endpoint.name %></div>
                  <div class="text-gray-500 dark:text-slate-400"><%= endpoint.role %></div>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-gray-500 dark:text-slate-300">
                  <%= endpoint.provider %><%= if endpoint.provider != "" and endpoint.region != "", do: " / " %><%= endpoint.region %>
                </td>
                <td class="px-4 py-4 text-sm">
                  <code class="break-all rounded bg-gray-100 px-2 py-1 text-gray-900 dark:bg-slate-800 dark:text-slate-100"><%= endpoint.endpoint %></code>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-gray-500 dark:text-slate-300">
                  <%= if endpoint.run != "", do: endpoint.run, else: endpoint.experiment %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</main>
